# Copiar a .env.local y completar. Nunca commitear .env.local.
ANTHROPIC_API_KEY=
# Fondo de recompensas por ronda y pago de la cobertura de riesgo base, en USDC de devnet
ROUND_POOL_USDC=1
COVER_PAYOUT_USDC=2
# Solana devnet. El resto (wallet del servidor, informantes, asegurado) lo escribe `npm run setup:devnet`.
SOLANA_RPC_URL=https://api.devnet.solana.com
